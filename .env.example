# 소설 백엔드 (기본: Ollama 의 Gemma4 26B-A4B). ollama pull 로 받은 태그 그대로 적는다.
NOVEL_LLM_BACKEND=ollama
NOVEL_LLM_MODEL=hf.co/HauhauCS/Gemma4-26B-A4B-Uncensored-HauhauCS-Balanced:Q4_K_M
NOVEL_LLM_OLLAMA_BASE_URL=http://127.0.0.1:11434
# 테스트/CI: 모델 없이 고정 응답
# NOVEL_LLM_DRY_RUN=1

# 레거시 Qwen3.5-4B 모델 서버 (NOVEL_LLM_BACKEND=local 일 때만)
NOVEL_LLM_BASE_URL=http://127.0.0.1:8765
# NOVEL_QWEN_PYTHON=C:\path\to\python.exe
# NOVEL_QWEN_MODEL_DIR=C:\path\to\qwen35-4b
# NOVEL_QWEN_ADAPTERS=cute=C:\path\to\adapters\cute

# 레거시 연구 UI (app.py, JEPA 파이프라인)
NOVEL_JEPA_OLLAMA_BASE_URL=http://localhost:11434
NOVEL_JEPA_CHAT_MODEL=gemma4:e4b
NOVEL_JEPA_EMBED_MODEL=embeddinggemma:latest
NOVEL_JEPA_OUTPUT_ROOT=.
NOVEL_JEPA_SERVICE_NAME=Novel JEPA Lab Admin
NOVEL_JEPA_BIND_HOST=127.0.0.1
NOVEL_JEPA_PORT=8502
NOVEL_JEPA_REQUIRE_AUTH=false

# 소비자 웹
NOVEL_JEPA_CONSUMER_BIND_HOST=0.0.0.0
NOVEL_JEPA_CONSUMER_PORT=8501
NOVEL_JEPA_CONSUMER_DB=.runtime/consumer.sqlite3
NOVEL_JEPA_CONSUMER_STORY_ROOT=data/consumer_stories

# Optional token for the localhost admin UI.
# NOVEL_JEPA_ACCESS_TOKEN=replace-with-a-long-random-token
